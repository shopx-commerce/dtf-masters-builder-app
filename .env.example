# Copy to .env for local development. The server loads .env at startup.
# On Replit these come from Secrets and [userenv.shared] in .replit instead.

# --- AI upscale ("Increase Quality") ---
# Required unless the local Real-ESRGAN engine below is installed.
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# auto (default) uses the local engine when REAL_ESRGAN_BIN exists, else Replicate.
UPSCALE_PROVIDER=auto

# Local open-source engine. Install with scripts/setup-local-upscaler.sh
# (Linux + Vulkan GPU only). See docs/local-upscale.md.
REAL_ESRGAN_BIN=
REAL_ESRGAN_MODEL_DIR=
REAL_ESRGAN_TILE=

# --- Storage / storefront (unrelated to upscale, listed for completeness) ---
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SENDGRID_API_KEY=
