# Copy to .env for local development. The server loads .env at startup.
# On Replit these come from Secrets and [userenv.shared] in .replit instead.

# --- AI upscale ("Increase Quality") ---
# Required unless the local Real-ESRGAN engine below is installed.
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# auto (default) uses the local engine when REAL_ESRGAN_BIN exists, else Replicate.
UPSCALE_PROVIDER=auto

# Local open-source engine. Install with scripts/setup-local-upscaler.sh
# (Linux + Vulkan GPU only). See docs/local-upscale.md.
REAL_ESRGAN_BIN=
REAL_ESRGAN_MODEL_DIR=
REAL_ESRGAN_TILE=

# --- Deployment (set these before the security middleware is of any use) ---

# REQUIRED behind a load balancer, CDN or Shopify App Proxy. Rate limiting keys
# off req.ip, which is the immediate peer, so leaving this unset puts *every*
# customer in one shared bucket and a busy store will start seeing 429s under
# ordinary traffic. Set to the hop count in front of this app (usually 1), or
# `true`. Left unset by default because trusting X-Forwarded-For when nothing
# sets it would let a caller forge its own rate-limit key.
TRUST_PROXY=

# Overrides the frame-ancestors allowlist wholesale (space-separated CSP source
# list). Only needed if the storefront frames the builder from an origin that is
# neither SHOP_CUSTOM_DOMAIN/SHOPIFY_STORE_DOMAIN nor *.myshopify.com — for
# instance a www. host when the domain below has no www.
FRAME_ANCESTORS=

# Per-IP request ceilings per 5-minute window (mail is per hour). Defaults are
# in server/routes.ts and are deliberately loose; raise them rather than
# throttling real customers. RATE_LIMIT_DISABLED=1 turns limiting off entirely,
# which is for local harnesses only.
RATE_LIMIT_API=
RATE_LIMIT_PROXY=
RATE_LIMIT_IMAGE=
RATE_LIMIT_MAIL=
RATE_LIMIT_DISABLED=

# --- Storage / storefront (unrelated to upscale, listed for completeness) ---
R2_ACCOUNT_ID=
R2_API_TOKEN=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SENDGRID_API_KEY=
