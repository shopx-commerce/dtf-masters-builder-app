{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "client/src/lib/cadcut-bounds.ts",
    "client/src/lib/cadcut-contour.ts",
    "client/src/lib/canvas-utils.ts",
    "client/src/lib/ctcontour.ts",
    "client/src/lib/image-utils.ts",
    "client/src/lib/shape-outline.ts",
    "client/src/lib/silhouette-contour.ts",
    "client/src/lib/true-contour.ts",
    "client/src/lib/unified-contour.ts",
    "client/src/lib/vector-stroke.ts"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
